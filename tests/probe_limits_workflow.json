    "jsCode": "\nconst pick = (name) => {\n  const r = $(name).first().json || {};\n  const h = r.headers || {}, keep = {};\n  Object.keys(h).forEach(k => { if (/^x-ratelimit|^retry-after/i.test(k)) keep[k] = h[k]; });\n  const b = r.body || {};\n  return { status: r.statusCode, rate_limit_headers: keep, error: b.error ? b.error.message : null, tokens_used_by_this_probe: b.usage ? b.usage.total_tokens : null };\n};\nreturn [{ json: { checked_at: new Date().toISOString(), gpt_oss_120b: pick('P120'), gpt_oss_20b: pick('P20') } }];\n"
